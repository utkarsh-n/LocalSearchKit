@@ -406,6 +406,15 @@ static bool ggml_metal_library_compile_all(
 
 // look for <name>.metallib as a bundle resource, then next to the running binary
 static NSString * ggml_metal_find_metallib(NSBundle * bundle, NSString * name) {
+    // Static Swift package consumers keep kernels in their package resource bundle.
+    // Prefer its explicit directory before looking in the host application's bundle.
+    NSString * path_resource = [[NSProcessInfo processInfo].environment objectForKey:@"GGML_METAL_PATH_RESOURCES"];
+    if (path_resource.length > 0) {
+        NSString * configured = [path_resource stringByAppendingPathComponent:[name stringByAppendingPathExtension:@"metallib"]];
+        if ([[NSFileManager defaultManager] isReadableFileAtPath:configured]) {
+            return configured;
+        }
+    }
     NSError * error = nil;
 
     NSString * path_lib = [bundle pathForResource:name ofType:@"metallib"];
